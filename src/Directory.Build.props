<Project>
  <Import Project="..\build\common.props" />

  <PropertyGroup>
    <!-- Public APIs must be documented; common.props suppresses this for tests. -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <!-- Optional-parameter overload rules; API additions and removals are still tracked by RS0016/RS0017. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
